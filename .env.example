# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FACTORY_PORT: Custom port for the Factory server and Autonomous Daemons.
# Set to 3030 (or any free port) to avoid collisions with user host ports:
#   Port 3000: Tachyon Web Server
#   Port 5000: File Uploader Service
#   Port 8888: SearXNG Search Engine
#   Port 20128: OmniRoute AI Gateway and Dashboard
#   Port 20131: OmniRoute Internal Worker
#   Port 20132: OmniRoute Internal Proxy
FACTORY_PORT=3030

# FACTORY_API_BASE_URL: Base URL for background Python scripts (factory_engine, monitor, smart_selector)
# Defaults to http://localhost:3030 when FACTORY_PORT=3030 is set.
FACTORY_API_BASE_URL="http://localhost:3030"
